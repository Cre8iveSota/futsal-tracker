rules_version = '2';

// Firebase コンソール → Firestore Database → ルール にこの内容を貼り付けてください。
// 閲覧は誰でも可能、書き込みは ALLOWED_EMAILS に列挙したGoogleアカウントのみ許可します。
service cloud.firestore {
  match /databases/{database}/documents {
    match /matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email in [
          'cre8ivesot@gmail.com'
          // 'hongo-no-google-account@example.com',  // 本郷さんのGoogleアカウントのメールアドレスに置き換えてコメントを外す
        ];
    }
  }
}
